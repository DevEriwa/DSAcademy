@model List<Core.ViewModels.CompanyViewModel>

@{
    ViewData["Title"] = "All Schools";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-building me-2"></i> All Schools</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="SuperAdmin" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active">Schools</li>
                </ol>
            </nav>
        </div>
        <a asp-controller="SuperAdmin" asp-action="CreateSchool" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add New School
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="schoolsTable">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>School Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th>Date Added</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int i = 1;
                            foreach (var school in Model)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td class="fw-semibold">@school.Name</td>
                                    <td>@school.Email</td>
                                    <td>@school.Phone</td>
                                    <td>
                                        @if (school.Active)
                                        {
                                            <span class="badge bg-success px-3 py-2">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2">Inactive</span>
                                        }
                                    </td>
                                    <td>@school.DateCreated.ToString("dd MMM yyyy")</td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-controller="SuperAdmin" asp-action="SchoolTheme"
                                               asp-route-companyId="@school.Id"
                                               class="btn btn-sm btn-outline-primary" title="Theme Settings">
                                                <i class="bi bi-palette"></i>
                                            </a>
                                            @if (school.Active)
                                            {
                                                <button class="btn btn-sm btn-outline-warning"
                                                        onclick="toggleStatus('@school.Id', false)" title="Deactivate">
                                                    <i class="bi bi-pause-circle"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-success"
                                                        onclick="toggleStatus('@school.Id', true)" title="Activate">
                                                    <i class="bi bi-play-circle"></i>
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-danger"
                                                    onclick="deleteSchool('@school.Id', '@school.Name')" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="bi bi-building fs-1 d-block mb-3 opacity-25"></i>
                                    <h5>No schools yet</h5>
                                    <a asp-controller="SuperAdmin" asp-action="CreateSchool" class="btn btn-primary mt-2">
                                        <i class="bi bi-plus-circle me-1"></i> Add First School
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>

@section Scripts {
<script>
    function toggleStatus(companyId, activate) {
        const msg = activate ? 'activate' : 'deactivate';
        Swal.fire({
            title: `Are you sure?`,
            text: `Do you want to ${msg} this school?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#0253cc',
            cancelButtonColor: '#d33',
            confirmButtonText: `Yes, ${msg} it!`
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('/SuperAdmin/ToggleSchoolStatus', { companyId: companyId, activate: activate }, function (res) {
                    if (!res.isError) {
                        successAlertWithRedirect(res.msg, '/SuperAdmin/Schools');
                    } else {
                        errorAlert(res.msg);
                    }
                });
            }
        });
    }

    function deleteSchool(companyId, name) {
        Swal.fire({
            title: `Delete "${name}"?`,
            text: 'This action cannot be undone.',
            icon: 'error',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#aaa',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('/SuperAdmin/DeleteSchool', { companyId: companyId }, function (res) {
                    if (!res.isError) {
                        successAlertWithRedirect(res.msg, '/SuperAdmin/Schools');
                    } else {
                        errorAlert(res.msg);
                    }
                });
            }
        });
    }
</script>
}
