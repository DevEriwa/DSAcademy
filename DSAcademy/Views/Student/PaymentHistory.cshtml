@model List<Core.Models.Payments>
@{
    ViewData["Title"] = "My Payment History";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}
<div class="ttr-wrapper">
    <div class="container-fluid">
        <div class="db-breadcrumb">
            <h4 class="breadcrumb-title">My Payment History</h4>
            <ul class="db-breadcrumb-list">
                <li><a asp-controller="Student" asp-action="Index"><i class="fa fa-home"></i> Home</a></li>
                <li>Payment History</li>
            </ul>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="widget-box">
                    <div class="wc-title">
                        <h4><i class="ti-credit-card me-2"></i> All My Payments</h4>
                    </div>
                    <div class="widget-inner">
                        @if (Model != null && Model.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Invoice No.</th>
                                            <th>Course</th>
                                            <th>Payment Type</th>
                                            <th>Status</th>
                                            <th>Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int i = 1; }
                                        @foreach (var p in Model)
                                        {
                                            <tr>
                                                <td>@i</td>
                                                <td><code>@p.InvoiceNumber</code></td>
                                                <td>@(p.Courses?.Title ?? "—")</td>
                                                <td>@p.Source</td>
                                                <td>
                                                    @switch (p.Status)
                                                    {
                                                        case Core.Enum.PaymentStatus.Approved:
                                                            <span class="badge bg-success">Approved</span>
                                                            break;
                                                        case Core.Enum.PaymentStatus.Declined:
                                                            <span class="badge bg-danger">Declined</span>
                                                            break;
                                                        default:
                                                            <span class="badge bg-warning text-dark">Pending</span>
                                                            break;
                                                    }
                                                </td>
                                                <td>@p.DateCreated.ToString("dd MMM yyyy")</td>
                                            </tr>
                                            i++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="ti-credit-card" style="font-size:3rem; display:block; margin-bottom:12px; opacity:.3;"></i>
                                <h5>No payment records yet</h5>
                                <a asp-controller="Student" asp-action="StudentCourses" class="btn btn-primary mt-2">Browse Courses</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
