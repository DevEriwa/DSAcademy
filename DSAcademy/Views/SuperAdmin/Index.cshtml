@model Core.ViewModels.SuperAdminDashboardViewModel

@{
    ViewData["Title"] = "Super Admin Dashboard";
    Layout = "~/Views/Shared/_SuperAdminLayout.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h1><i class="ti-dashboard me-2"></i> Super Admin Dashboard</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="SuperAdmin" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active">Dashboard</li>
            </ol>
        </nav>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <section class="section dashboard">
        <!-- ── Stat Cards ───────────────────────────────────────────── -->
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6">
                <div class="card info-card h-100 border-0 shadow-sm">
                    <div class="card-body d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="background:#e3f2fd; width:56px; height:56px;">
                            <i class="bi bi-building fs-4 text-primary"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0">Total Schools</h6>
                            <h3 class="fw-bold mb-0">@Model.TotalSchools</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card info-card h-100 border-0 shadow-sm">
                    <div class="card-body d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="background:#e8f5e9; width:56px; height:56px;">
                            <i class="bi bi-check-circle fs-4 text-success"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0">Active Schools</h6>
                            <h3 class="fw-bold mb-0">@Model.ActiveSchools</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card info-card h-100 border-0 shadow-sm">
                    <div class="card-body d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="background:#fce4ec; width:56px; height:56px;">
                            <i class="bi bi-people fs-4 text-danger"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0">Total Students</h6>
                            <h3 class="fw-bold mb-0">@Model.TotalStudents</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card info-card h-100 border-0 shadow-sm">
                    <div class="card-body d-flex align-items-center">
                        <div class="card-icon rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="background:#fff8e1; width:56px; height:56px;">
                            <i class="bi bi-credit-card fs-4 text-warning"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0">Total Payments</h6>
                            <h3 class="fw-bold mb-0">@Model.TotalPayments</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Recent Schools ──────────────────────────────────────── -->
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center bg-white border-bottom">
                        <h5 class="mb-0 fw-bold">Recently Added Schools</h5>
                        <a asp-controller="SuperAdmin" asp-action="Schools" class="btn btn-sm btn-primary">
                            <i class="bi bi-grid me-1"></i> View All Schools
                        </a>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>School Name</th>
                                        <th>Email</th>
                                        <th>Status</th>
                                        <th>Date Added</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.RecentSchools.Any())
                                    {
                                        int i = 1;
                                        foreach (var school in Model.RecentSchools)
                                        {
                                            <tr>
                                                <td>@i</td>
                                                <td class="fw-semibold">@school.Name</td>
                                                <td>@school.Email</td>
                                                <td>
                                                    @if (school.Active)
                                                    {
                                                        <span class="badge bg-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Inactive</span>
                                                    }
                                                </td>
                                                <td>@school.DateCreated.ToString("dd MMM yyyy")</td>
                                                <td class="text-center">
                                                    <a asp-controller="SuperAdmin" asp-action="SchoolTheme"
                                                       asp-route-companyId="@school.Id"
                                                       class="btn btn-sm btn-outline-primary" title="Theme Settings">
                                                        <i class="bi bi-palette"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                            i++;
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">
                                                <i class="bi bi-building fs-3 d-block mb-2"></i>
                                                No schools onboarded yet.
                                                <a asp-controller="SuperAdmin" asp-action="CreateSchool">Add one now</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
